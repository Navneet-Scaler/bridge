# Copy to .env and fill in real values. NEVER commit .env.
#
# Bridge extends Cadence's database rather than standing up its own, so these
# point at the SAME Postgres instance Cadence uses. If you have Cadence running
# locally (`make db-up` in that repo), these defaults already work unchanged.
DB_HOST=localhost
DB_PORT=5433
DB_USER=cadence_user
DB_PASSWORD=changeme
DB_NAME=cadence

# Metabase (local container, shared with Cadence)
METABASE_PORT=3000

# Simulation controls (see src/simulate/generate_liquidity_events.py).
# SIM_RANDOM_SEED must match Cadence's, or the portfolio trajectories stop
# lining up with the transaction history they are supposed to be built from.
SIM_RANDOM_SEED=42
SIM_START_DATE=2025-01-01
SIM_END_DATE=2025-12-31
